# =============================================
# FlareBoard Frontend - Environment Variables
# =============================================
# Copy this to .env.local for development
# Set these in Vercel Dashboard → Settings → Environment Variables

# Your Railway backend URL (with /api suffix)
# Production example: https://flareboard-api.up.railway.app/api
VITE_API_URL=http://localhost:3000/api

# Your Railway backend URL for WebSocket (no /api suffix)
# Production example: https://flareboard-api.up.railway.app
VITE_SOCKET_URL=http://localhost:3000
