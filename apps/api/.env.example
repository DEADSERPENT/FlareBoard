# =============================================
# FlareBoard API — Environment Variables
# =============================================
# For LOCAL development: copy this to .env
# For PRODUCTION (Railway): set these in Railway Dashboard → Variables

# ── DATABASE ─────────────────────────────────
# LOCAL (Docker):
DATABASE_URL="postgresql://postgres:root@localhost:5432/flareboard"
DIRECT_URL="postgresql://postgres:root@localhost:5432/flareboard"

# PRODUCTION (Supabase) — replace the values above with:
# DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
# (Transaction pooler URL for DATABASE_URL, Direct connection URL for DIRECT_URL)

# ── SERVER ───────────────────────────────────
PORT=3000
NODE_ENV=development

# ── AUTH ─────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=local-dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# ── ADMIN SEED ───────────────────────────────
# Used by prisma/seed.ts to create the admin account
# Change these before running seed in production
ADMIN_EMAIL=admin@flareboard.com
ADMIN_PASSWORD=password123

# ── CORS ─────────────────────────────────────
# LOCAL: your Vite dev server port
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# PRODUCTION: your Vercel URL (no trailing slash)
# ALLOWED_ORIGINS=https://your-app.vercel.app
